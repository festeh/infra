{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    {{ private_harnesses_opencode_provider | to_json }}: {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": {{ private_harnesses_opencode_base_url | to_json }},
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
{% for model, label in private_harnesses_opencode_models.items() %}
        {{ model | to_json }}: { "name": {{ label | to_json }} }{{ "," if not loop.last }}
{% endfor %}
      }
    }
  },
  "model": {{ (private_harnesses_opencode_provider ~ '/' ~ private_harnesses_opencode_model) | to_json }},
  "small_model": {{ (private_harnesses_opencode_provider ~ '/' ~ private_harnesses_opencode_small_model) | to_json }}
}
